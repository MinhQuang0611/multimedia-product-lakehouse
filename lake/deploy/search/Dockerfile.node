# Node tìm kiếm: chỉ FAISS + đọc Parquet, không torch/GPU (coordinator gửi vector đã tính).
# Mã nguồn và dữ liệu gắn từ ngoài (read-only) nên đổi code không cần build lại image.
FROM python:3.11-slim
RUN pip install --no-cache-dir faiss-cpu==1.15.1 numpy==2.4.6 duckdb==1.5.6 pyarrow==26.0.0 pillow==13.0.0 \
        fastapi==0.162.0 uvicorn==0.54.0 pydantic-settings==2.16.1
WORKDIR /app/lake
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "uvicorn", "src.search.node:app", "--host", "0.0.0.0", "--port", "8000"]
