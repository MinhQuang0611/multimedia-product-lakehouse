# Sao chép thành .env để đổi tài khoản (docker compose và pipeline cùng đọc).
# Giá trị dưới đây là mặc định cho môi trường dev trên một máy.
LAKE_ACCESS_KEY=lakeadmin
LAKE_SECRET_KEY=lakeadmin123

# Superuser Postgres. Tài khoản kho dữ liệu (DW_*) nằm riêng ở data_warehouse/.env.
POSTGRES_PASSWORD=postgres
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_JWT_SECRET=btl-dev-jwt-secret
SUPERSET_DB_PASSWORD=superset
SUPERSET_SECRET_KEY=btl-dev-superset-secret-change-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
